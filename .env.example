FLOODILKA_BOT_TOKEN=your_bot_token_here
FLOODILKA_API=https://floodilka.com/api/v1
FLOODILKA_GATEWAY=wss://gateway.floodilka.com/?v=1&encoding=json

# Источник музыки. Без этого токена поиск по названию не работает —
# будут проигрываться только прямые ссылки.
YANDEX_MUSIC_TOKEN=

# ── Нагрузка ────────────────────────────────────────────────────────────────
# Максимум одновременных голосовых сессий (каждая = 1 процесс FFmpeg).
# Упирается в CPU, а не в Python: замеры на 8 ядрах — 150 потоков идут ровно,
# на 200 начинается отставание от реального времени. Ориентир: ~15-20 на ядро.
MAX_VOICE_SESSIONS=50
# Буфер аудио в LiveKit, мс. Больше = устойчивее к лагам, медленнее пауза.
AUDIO_BUFFER_MS=500
# Сколько потоков можно запускать одновременно (сглаживает всплеск при старте).
START_CONCURRENCY=8
# Параллельные поиски треков во внешних API.
SEARCH_CONCURRENCY=8
# Размер пула для блокирующих операций (запуск FFmpeg, поиск).
BLOCKING_WORKERS=32
# Максимум треков в очереди одной гильдии.
MAX_QUEUE_LEN=100
# Автовыход из голосового канала при простое, сек.
IDLE_TIMEOUT=1800

# ── Антиспам ────────────────────────────────────────────────────────────────
# Не более USER_RATE_LIMIT команд от одного юзера за USER_RATE_WINDOW секунд.
USER_RATE_LIMIT=5
USER_RATE_WINDOW=10

# ── HTTP к API Floodilka ────────────────────────────────────────────────────
HTTP_CONCURRENCY=50
HTTP_MAX_RETRIES=3
HTTP_TIMEOUT=20

# Отключить проверку TLS (0). Оставьте 1 — сертификаты floodilka валидны.
FLOODILKA_SSL_VERIFY=1
LOG_LEVEL=INFO
